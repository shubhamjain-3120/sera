DATABASE_URL=sqlite:///./data/formfiller.db
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./data/objects
REDIS_URL=redis://localhost:6379/0
REDUCTO_API_KEY=
REDUCTO_BASE_URL=https://platform.reducto.ai
EVIDENCE_REQUIRE_REDUCTO=true
# Model Gateway. Leave OPENAI_API_KEY blank to run every stage deterministically.
OPENAI_API_KEY=
MODEL_TEMPLATE_ANALYSIS=gpt-5.6-luna
MODEL_EVIDENCE_EXTRACTION=gpt-5.6-luna
MODEL_MAPPING=gpt-5.6-luna
MODEL_VERIFICATION=gpt-5.6-luna
VITE_API_URL=http://localhost:8000
MODEL_REASONING_EFFORT=max
MODEL_BATCH_SIZE=20
MODEL_TIMEOUT_SECONDS=300
